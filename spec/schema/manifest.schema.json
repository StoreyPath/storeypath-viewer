{
  "$defs": {
    "ExportInfo": {
      "properties": {
        "sequence": {
          "description": "1 for the project's first export, then 2, 3, \u2026",
          "title": "Sequence",
          "type": "integer"
        },
        "exported_at": {
          "format": "date-time",
          "title": "Exported At",
          "type": "string"
        },
        "previous_sequence": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the sequence of the last export that held this building (format 0.7; null for its first): what changes.json lists changes since. A gap from the last package of the building a reader has applied means it missed one",
          "title": "Previous Sequence"
        }
      },
      "required": [
        "sequence",
        "exported_at"
      ],
      "title": "ExportInfo",
      "type": "object"
    },
    "Generator": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "Generator",
      "type": "object"
    },
    "PlacementInfo": {
      "description": "Lets a consumer rebuild local drawing coordinates in meters.",
      "properties": {
        "lon": {
          "title": "Lon",
          "type": "number"
        },
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "bearing": {
          "title": "Bearing",
          "type": "number"
        },
        "projection": {
          "default": "aeqd centred on (lon, lat), drawing +Y rotated to bearing",
          "title": "Projection",
          "type": "string"
        },
        "placed": {
          "default": true,
          "description": "false: the building is not placed on the map yet; it is exported around 0\u00b0N 0\u00b0E with its true shape and size, but its position on earth is not known",
          "title": "Placed",
          "type": "boolean"
        },
        "site": {
          "anyOf": [
            {
              "$ref": "#/$defs/SiteFrame"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "(format 0.12) where the building's own frame lies on its location's site, the frame its layout is drawn in; null: placed on the map by itself. A layout's own placement has none: it is the site's"
        }
      },
      "required": [
        "lon",
        "lat",
        "x",
        "y",
        "bearing"
      ],
      "title": "PlacementInfo",
      "type": "object"
    },
    "ProjectInfo": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ProjectInfo",
      "type": "object"
    },
    "Scope": {
      "description": "The building a package holds (from format 0.7, exactly one; before, the part of\nthe project it held when not all of it), or (0.12) the location's layout it holds.",
      "properties": {
        "buildings": {
          "description": "IDs of the buildings in the package (from 0.7: one; a layout's package: none); the rest of the project is not in it, and its absence says nothing about it",
          "items": {
            "type": "string"
          },
          "title": "Buildings",
          "type": "array"
        },
        "layout": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "(format 0.12) the ID of the location's layout the package holds, in place of a building",
          "title": "Layout"
        }
      },
      "required": [
        "buildings"
      ],
      "title": "Scope",
      "type": "object"
    },
    "SiteFrame": {
      "description": "Where a building's own frame lies on its location's site (format 0.12).",
      "properties": {
        "x_m": {
          "description": "its frame's origin in the site's frame, metres",
          "title": "X M",
          "type": "number"
        },
        "y_m": {
          "title": "Y M",
          "type": "number"
        },
        "rotation_deg": {
          "description": "how far it is turned, degrees clockwise: a point (x, y) of its frame is at (x_m + x cos r + y sin r, y_m - x sin r + y cos r) in the site's",
          "title": "Rotation Deg",
          "type": "number"
        }
      },
      "required": [
        "x_m",
        "y_m",
        "rotation_deg"
      ],
      "title": "SiteFrame",
      "type": "object"
    },
    "SourceInfo": {
      "properties": {
        "floor_id": {
          "title": "Floor Id",
          "type": "string"
        },
        "file": {
          "description": "file name only; local paths are not exported",
          "title": "File",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "view": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the floor's drawing as drawn, in the package (format 0.11, when the export carries the drawings): drawings/<floor-id>.view, a drawing view (spec/DRAWING-VIEW.md) of the floor's part of the drawing in the building's own frame; null: not carried",
          "title": "View"
        }
      },
      "required": [
        "floor_id",
        "file"
      ],
      "title": "SourceInfo",
      "type": "object"
    }
  },
  "properties": {
    "format": {
      "const": "storeypath-package",
      "default": "storeypath-package",
      "title": "Format",
      "type": "string"
    },
    "format_version": {
      "default": "0.13.0",
      "title": "Format Version",
      "type": "string"
    },
    "generator": {
      "$ref": "#/$defs/Generator"
    },
    "project": {
      "$ref": "#/$defs/ProjectInfo"
    },
    "export": {
      "$ref": "#/$defs/ExportInfo"
    },
    "crs": {
      "const": "EPSG:4326",
      "default": "EPSG:4326",
      "title": "Crs",
      "type": "string"
    },
    "length_unit": {
      "const": "m",
      "default": "m",
      "title": "Length Unit",
      "type": "string"
    },
    "files": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Files",
      "type": "object"
    },
    "counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Counts",
      "type": "object"
    },
    "types": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Types",
      "type": "object"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceInfo"
      },
      "title": "Sources",
      "type": "array"
    },
    "placements": {
      "additionalProperties": {
        "$ref": "#/$defs/PlacementInfo"
      },
      "title": "Placements",
      "type": "object"
    },
    "scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/Scope"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The building it holds (from 0.7, always one); before 0.7, absent: the whole project"
    }
  },
  "required": [
    "generator",
    "project",
    "export",
    "files",
    "counts",
    "types",
    "sources",
    "placements"
  ],
  "title": "Manifest",
  "type": "object"
}