{
  "$defs": {
    "ItemField": {
      "description": "A detail an item of this type carries.",
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "name_en": {
          "title": "Name En",
          "type": "string"
        },
        "name_ar": {
          "default": "",
          "title": "Name Ar",
          "type": "string"
        },
        "kind": {
          "default": "text",
          "enum": [
            "text",
            "number",
            "choice",
            "color"
          ],
          "title": "Kind",
          "type": "string"
        },
        "choices": {
          "items": {
            "type": "string"
          },
          "title": "Choices",
          "type": "array"
        },
        "owner": {
          "default": "storeypath",
          "enum": [
            "storeypath",
            "system"
          ],
          "title": "Owner",
          "type": "string"
        }
      },
      "required": [
        "key",
        "name_en"
      ],
      "title": "ItemField",
      "type": "object"
    },
    "ItemPlan": {
      "description": "How a type's items look from above, line for line as a drawing has them (format\n0.13.2; FORMAT.md, Plan drawings): metres in the type's own frame, its middle at (0, 0),\nx across it, its front towards -y. ``lines``: polylines (a closed one repeats its first\npoint); ``outline``: its footprint for 3D, polygons of rings (the first the boundary,\nthe rest holes; the first point not repeated). Drawn in place of its shape.",
      "properties": {
        "lines": {
          "items": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "type": "array"
          },
          "title": "Lines",
          "type": "array"
        },
        "outline": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "items": {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "type": "array"
                  },
                  "type": "array"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outline"
        }
      },
      "required": [
        "lines"
      ],
      "title": "ItemPlan",
      "type": "object"
    },
    "ItemType": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "name_en": {
          "title": "Name En",
          "type": "string"
        },
        "name_ar": {
          "default": "",
          "title": "Name Ar",
          "type": "string"
        },
        "category": {
          "default": "furniture",
          "enum": [
            "workstations",
            "seating",
            "tables",
            "storage",
            "soft_seating",
            "beds",
            "furniture",
            "security",
            "fire_safety",
            "it_av",
            "building_services",
            "appliances",
            "equipment"
          ],
          "title": "Category",
          "type": "string"
        },
        "width": {
          "default": 1.0,
          "title": "Width",
          "type": "number"
        },
        "depth": {
          "default": 0.6,
          "title": "Depth",
          "type": "number"
        },
        "height": {
          "default": 0.75,
          "title": "Height",
          "type": "number"
        },
        "mount": {
          "default": "floor",
          "enum": [
            "floor",
            "wall",
            "ceiling"
          ],
          "title": "Mount",
          "type": "string"
        },
        "elevation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elevation"
        },
        "color": {
          "default": "#8a8a8a",
          "title": "Color",
          "type": "string"
        },
        "shape": {
          "anyOf": [
            {
              "enum": [
                "desk",
                "table",
                "chair",
                "side_chair",
                "armchair",
                "sofa",
                "storage",
                "screen",
                "copier",
                "bed",
                "kiosk",
                "access_point",
                "camera",
                "box"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shape"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemPlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "workplaces": {
          "default": 0,
          "maximum": 100,
          "minimum": 0,
          "title": "Workplaces",
          "type": "integer"
        },
        "grade": {
          "anyOf": [
            {
              "enum": [
                "president",
                "c_level",
                "director",
                "manager",
                "section_head",
                "senior",
                "junior"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grade"
        },
        "view_deg": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 360,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "View Deg"
        },
        "range_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 500,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Range M"
        },
        "serves_door": {
          "default": false,
          "title": "Serves Door",
          "type": "boolean"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/ItemField"
          },
          "title": "Fields",
          "type": "array"
        },
        "retired": {
          "default": false,
          "title": "Retired",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "name_en"
      ],
      "title": "ItemType",
      "type": "object"
    }
  },
  "properties": {
    "format": {
      "const": "storeypath-catalogue",
      "default": "storeypath-catalogue",
      "title": "Format",
      "type": "string"
    },
    "format_version": {
      "default": 2,
      "title": "Format Version",
      "type": "integer"
    },
    "types": {
      "items": {
        "$ref": "#/$defs/ItemType"
      },
      "title": "Types",
      "type": "array"
    }
  },
  "title": "Catalogue",
  "type": "object"
}