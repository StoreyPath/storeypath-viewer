{
  "name": "@storeypath/viewer",
  "version": "0.1.0",
  "description": "StoreyPath Viewer: web viewer engines for StoreyPath indoor map packages: a walk-through 3D world, a map view and the drawings themselves",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./world": "./src/world/world.js",
    "./navigation": {
      "types": "./src/navigation.d.ts",
      "default": "./src/navigation.js"
    },
    "./ids": {
      "types": "./src/ids.d.ts",
      "default": "./src/ids.js"
    },
    "./drawing": {
      "types": "./src/drawing/drawing.d.ts",
      "default": "./src/drawing/drawing.js"
    },
    "./drawing/view": {
      "types": "./src/drawing/view.d.ts",
      "default": "./src/drawing/view.js"
    },
    "./viewer.css": "./src/viewer.css",
    "./drawing.css": "./src/drawing/drawing.css"
  },
  "files": [
    "src",
    "vendor/n8ao"
  ],
  "peerDependencies": {
    "jszip": "^3.10.1",
    "maplibre-gl": "^4.7.1",
    "three": ">=0.186.0"
  },
  "keywords": [
    "indoor-mapping",
    "floor-plans",
    "wayfinding",
    "maplibre",
    "threejs",
    "webgl",
    "3d"
  ],
  "license": "Apache-2.0",
  "author": "Khalefa <storeypath@alahmad.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StoreyPath/storeypath-viewer.git",
    "directory": "viewer"
  },
  "peerDependenciesMeta": {
    "maplibre-gl": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  }
}
